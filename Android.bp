package {
    default_applicable_licenses: ["external_bzip2_license"],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
//
// large-scale-change filtered out the below license kinds as false-positives:
//   SPDX-license-identifier-GPL
//   SPDX-license-identifier-OFL
// See: http://go/android-license-faq
license {
    name: "external_bzip2_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-BSD",
        "legacy_unencumbered",
    ],
    license_text: [
        "LICENSE",
    ],
}

cc_library_static {
    name: "libbz",
    host_supported: true,
    vendor_available: true,
    recovery_available: true,
    visibility: [
        "//bootable/recovery:__subpackages__",
        "//bootable/deprecated-ota:__subpackages__",
        "//external/bsdiff:__subpackages__",
        "//external/puffin:__subpackages__",
        "//external/python/cpython3:__subpackages__",
        "//system/update_engine:__subpackages__",
        "//vendor:__subpackages__",
    ],
    arch: {
        arm: {
            // measurements show that the ARM version of ZLib is about x1.17 faster
            // than the thumb one...
            instruction_set: "arm",
        },
    },
    cflags: select(release_flag("RELEASE_USE_RUST_BZIP2"), {
        true: [],
        default: [
            "-O3",
            "-DUSE_MMAP",
            "-Werror",
            "-Wno-unused-parameter",
        ],
    }),
    export_include_dirs: ["."],
    srcs: select(release_flag("RELEASE_USE_RUST_BZIP2"), {
        true: [],
        default: [
            "blocksort.c",
            "bzlib.c",
            "compress.c",
            "crctable.c",
            "decompress.c",
            "huffman.c",
            "randtable.c",
        ],
    }),
    whole_static_libs: select(release_flag("RELEASE_USE_RUST_BZIP2"), {
        true: ["liblibbz2_rs_sys_static"],
        default: [],
    }),
    stl: "none",
}

cc_library_static {
    // This module is intended for use by legacy Android.mk
    // modules where Rust support is limited.
    name: "libbz_cc",
    host_supported: true,
    vendor_available: true,
    recovery_available: true,
    visibility: [
        "//bootable/recovery:__subpackages__",
        "//bootable/deprecated-ota:__subpackages__",
        "//external/bsdiff:__subpackages__",
        "//external/puffin:__subpackages__",
        "//external/python/cpython3:__subpackages__",
        "//system/update_engine:__subpackages__",
        "//vendor:__subpackages__",
    ],
    arch: {
        arm: {
            // measurements show that the ARM version of ZLib is about x1.17 faster
            // than the thumb one...
            instruction_set: "arm",
        },
    },
    cflags: [
        "-O3",
        "-DUSE_MMAP",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    export_include_dirs: ["."],

    // Prevents collision with Rust bzip2 when the flag is enabled
    enabled: select(release_flag("RELEASE_USE_RUST_BZIP2"), {
        true: true,
        default: false,
    }),

    // Because we're setting enabled above, this overrides the default
    // beahvior of Soong to not build the Windows target.
    target: {
        windows: {
            enabled: false,
        },
    },

    srcs: [
        "blocksort.c",
        "bzlib.c",
        "compress.c",
        "crctable.c",
        "decompress.c",
        "huffman.c",
        "randtable.c",
    ],
    stl: "none",
}

cc_binary {
    name: "bzip2_c",
    stem: "bzip2",
    host_supported: true,
    target: {
        windows: {
            enabled: false,
        },
    },
    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
    ],
    static_libs: ["libbz"],
    srcs: ["bzip2.c"],

    // Prevents collision with Rust bzip2 when the flag is enabled
    enabled: select(release_flag("RELEASE_USE_RUST_BZIP2_CLI"), {
        true: false,
        default: true,
    }),

    stl: "none",
    symlinks: [
        "bunzip2",
        "bzcat",
    ],
}

// This binary is defined in the bzip2-cli Rust crate, so we don't need it defined here.
// The select below can just select the bzip2-rs crate when the flag is enabled.
phony {
    name: "bzip2",
    required: select(release_flag("RELEASE_USE_RUST_BZIP2_CLI"), {
        true: ["bzip2_rs"],
        default: ["bzip2_c"],
    }),
}
